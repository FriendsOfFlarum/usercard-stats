{
    "name": "fof/usercard-stats",
    "description": "Add stats to the usercard for your forum users",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/usercard-stats/issues",
        "source": "https://github.com/FriendsOfFlarum/usercard-stats",
        "forum": "https://discuss.flarum.org/d/39016"
    },
    "homepage": "https://friendsofflarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "replace": {
        "blomstra/usercard-stats": "*"
    },
    "require": {
        "flarum/core": "^2.0.0"
    },
    "require-dev": {
        "flarum/phpstan": "^2.0"
    },
    "authors": [
        {
            "name": "FriendsOfFlarum",
            "email": "team@friendsofflarum.org",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\UsercardStats\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF Usercard Stats",
            "category": "feature",
            "icon": {
                "name": "fas fa-chart-bar",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
